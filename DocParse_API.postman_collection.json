									"description": "Optional: invoice, proforma, receipt, other",
									"disabled": true
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/documents/",
							"host": ["{{base_url}}"],
							"path": ["api", "documents", ""]
